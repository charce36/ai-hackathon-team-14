# Modo demo para grabación de video (auto-approve + delays)
VIDEO_DEMO=true
DEMO_STEP_DELAY_MS=800

# Claude Platform (requerido en runtime)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
RCA_CONFIDENCE_THRESHOLD=0.6

# Auto-approve delay en segundos (solo VIDEO_DEMO)
AUTO_APPROVE_DELAY_SEC=2
